{
  "name": "cleanloop",
  "private": true,
  "description": "Shared lint and format tooling for the CleanLoop projects",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "node frontend/preview-server/start.mjs",
    "preview:web": "node frontend/preview-server/start.mjs web",
    "preview:mobile": "node frontend/preview-server/start.mjs mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
